# Kopiera till .env och fyll i. .env är gitignorerad; den här filen är kartan.
#
# Utan nycklar skriver referensmottagaren "mejlen" som filer i outbox/ —
# hela inlämningskedjan går att prova utan konto hos någon.

# Resend: sätts BÅDA för att mejl ska skickas på riktigt i stället för till disk.
RESEND_API_KEY=
RESEND_FROM=

# Provadress: sätts den lägger mottagaren till en rad "Test (dig själv)" med
# den adressen och gör den till standard. För att prova kedjan på egen maskin —
# adressen stannar här, aldrig i katalogfilen som spåras.
RECEIVER_TEST_ADDRESS=

# Delningstunneln (npm run share:tunnel): ssh-målet för dev.flowweaver.se,
# som användare@värd. Hör till den här maskinen, inte till repot (DRIFT).
FW_TUNNEL_SSH=
