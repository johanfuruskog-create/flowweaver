integrations/sitevision-webapp/src/tokens.generated.js

# Genereras av scripts/generate-tokens.mjs vid varje bygge.

# En statisk ffmpeg för demofilmerna. 78 MB och plattformsbunden, så den hämtas
# i stället för att versioneras: `sudo apt-get install -y ffmpeg` räcker lika
# bra, och `FFMPEG_BIN=...` pekar ut en var som helst. Utan den blir filmen
# ändå gjord — den blir bara webm, som inte spelar i äldre telefoner.
tools/ffmpeg

# Filmerna bor som release-assets i flowweaver-film (src/site/film-release.json
# pekar ut vilken release). demo-film/ är arbetskatalogen install-films fyller
# och release-films laddar upp; bara textremsorna i public/film/ följer med i git.
demo-film/

# Demofilmernas utdata — de installerade tagningarna ligger i demo-film/.
# demo-submission/ saknades här och följde med i git (69 MB) tills historiken
# skrevs om 4/9; en ny demo-katalog läggs till HÄR, aldrig i git.
demo-*/
demo-ut/
demo-trail/
demo-hero/
demo-versions/
demo-fault-report/
demo-translate/
demo-promo/
demo-usp/
demo-promo-value/
