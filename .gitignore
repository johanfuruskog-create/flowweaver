.elevenlabs-key

# Fjärrloggarna från /__log, en fil per dag. Maskinlokala, aldrig i repot.
debug-*.log
debug.log

# Debug-bygget som fjärrloggningen serveras ur. Aldrig det som rullas ut.
dist-debug/

# Hemligheter. `.env` bär nycklar som aldrig får nå git — och `.env.example`
# är kartan som ska göra det, alltså undantagen. Regeln står här och inte i en
# undermapp: en nyckelfil kan hamna var som helst i trädet, och den som skapar
# den letar inte upp rätt ignore-fil först.
.env
.env.*
!.env.example

# Utrullningens version, skriven av tools/rollout-receiver.sh strax före rsync
# och borttagen direkt efteråt. Den beskriver en utrullning, aldrig en
# arbetskopia — och den ska därför inte kunna committas.
integrations/reference-receiver/version.json
